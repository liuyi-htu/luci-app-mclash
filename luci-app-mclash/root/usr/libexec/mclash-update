#!/bin/sh
# Official stable releases, verified downloads and atomic core replacement.
umask 077
CORE=/usr/bin/mihomo
INIT=/etc/init.d/mclash
UI=/usr/libexec/mclash-ui
CONFIG=/etc/mclash/config.yaml
CURL=/usr/bin/curl
TIMEOUT=/usr/libexec/mclash-timeout
LOCK=/var/lock/mclash-ui.lock
STATE=/var/run/mclash/update.status
UPLOAD=/tmp/mclash-mihomo.upload
. /usr/libexec/mclash-lock
WORK=''; STAGED=''; BACKUP=''; SWAPPED=0; SUCCESS=0; WAS_RUNNING=0; OWN_LOCK=0; STOPPED=0; FAILURE=''
progress() {
 mkdir -p /var/run/mclash
 /usr/libexec/mclash-log append-update "$1 $2% $3" || true
 printf '%s\t%s\t%s\n' "$1" "$2" "$3" > "$STATE.$$" && mv -f "$STATE.$$" "$STATE"
}
cleanup() {
 if [ "$SUCCESS" = 0 ] && [ "$SWAPPED" = 1 ]; then
  [ "$WAS_RUNNING" = 0 ] || "$INIT" stop >/dev/null 2>&1 || true
  if [ -n "$BACKUP" ] && [ -f "$BACKUP" ]; then
   mv -f "$BACKUP" "$CORE" && BACKUP='' && SWAPPED=0
  else rm -f "$CORE"; SWAPPED=0; fi
 fi
 if [ "$SUCCESS" = 0 ] && [ "$STOPPED" = 1 ] && [ "$WAS_RUNNING" = 1 ]; then
  if [ "$SWAPPED" = 0 ]; then
   if "$INIT" start >/dev/null 2>&1 && wait_ready; then
    progress error 100 "$FAILURE; Previous core restored; service is running again"
   else
    progress error 100 "$FAILURE; Previous core restored, but service restart failed; check the log"
   fi
  else
   progress error 100 "$FAILURE; Failed to restore the previous core; check the log; backup retained"
  fi
 fi
 [ -z "$STAGED" ] || rm -f "$STAGED"
 # Keep the backup if rollback failed.
 [ "$SWAPPED" = 1 ] && [ "$SUCCESS" = 0 ] || { [ -z "$BACKUP" ] || rm -f "$BACKUP"; }
 [ -z "$WORK" ] || rm -rf "$WORK"
 [ "$OWN_LOCK" = 0 ] || mclash_lock_release
}
fail() { FAILURE="$1"; progress error 100 "$1"; printf '%s\n' "$1" >&2; exit 1; }
wait_ready() {
 for n in $(seq 1 35); do
  [ "$("$UI" status | jsonfilter -e '@.running')" = true ] && return 0
  sleep 1
 done
 return 1
}
lock() {
 mkdir -p /var/lock
 mclash_lock_acquire update || { printf '%s\n' 'Another operation is in progress; retry later' >&2; exit 1; }
 OWN_LOCK=1
 trap cleanup EXIT
 trap 'fail "Update task interrupted"' HUP INT TERM
}
core_version() {
 "$TIMEOUT" 5 "$1" -v 2>/dev/null | awk '$1 == "Mihomo" && $2 == "Meta" {sub(/^v/,"",$3); print $3; exit}'
}
newer() {
 awk -v a="$1" -v b="$2" 'BEGIN {split(a,x,".");split(b,y,".");for(i=1;i<=3;i++){if(x[i]+0>y[i]+0)exit 0;if(x[i]+0<y[i]+0)exit 1}exit 1}'
}
metadata() {
 WORK="$(mktemp -d /tmp/mclash-update.XXXXXX)" || fail 'Unable to create update directory'
 "$CURL" -fLsS --max-time 20 --max-filesize 4194304 --proto '=https' --proto-redir '=https' \
  https://api.github.com/repos/MetaCubeX/mihomo/releases/latest -o "$WORK/release.json" 2>/dev/null || fail 'Failed to query the official release; check network connectivity or GitHub rate limits'
 LATEST="$(jsonfilter -i "$WORK/release.json" -e '@.tag_name')"
 printf '%s\n' "$LATEST" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$' || fail 'Invalid release version format'
 CURRENT="$(core_version "$CORE")"
}
case "${1:-}" in
 status)
  [ ! -f "$STATE" ] && printf 'idle\t0\tNo update has started.\n' || cat "$STATE"
  exit 0 ;;
 check)
  lock; metadata
  available=0; [ -n "$CURRENT" ] && ! newer "${LATEST#v}" "$CURRENT" || available=1
  SUCCESS=1
  printf '%s\t%s\t%s\n' "${CURRENT:-Not installed}" "$LATEST" "$available"
  exit 0 ;;
 online|local)
  lock
  [ "$1" != local ] || { [ -f "$UPLOAD" ] && [ ! -L "$UPLOAD" ] && [ -s "$UPLOAD" ]; } || fail 'Upload a core file first'
  progress running 1 'Starting update task…'
  /sbin/start-stop-daemon -S -b -O /dev/null -x /usr/libexec/mclash-update -- "worker-$1" claimed || fail 'Unable to start update task'
  OWN_LOCK=0
  printf '%s\n' 'Update task started'
  exit 0 ;;
 worker-online|worker-local)
  [ "${2:-}" = claimed ] && [ -d "$LOCK" ] || exit 1
  OWN_LOCK=1
  mclash_lock_claim update
  trap cleanup EXIT
  trap 'fail "Update task interrupted"' HUP INT TERM ;;
 *) exit 1 ;;
esac
mode="$1"
if [ "$mode" = worker-online ]; then
 progress running 10 'Checking the official stable release…'
 metadata
 if [ -n "$CURRENT" ] && ! newer "${LATEST#v}" "$CURRENT"; then
  SUCCESS=1; progress success 100 'Already up to date'; exit 0
 fi
 case "$(uname -m)" in
  aarch64|arm64) arch=arm64 ;;
  x86_64|amd64) arch=amd64-compatible ;;
  armv7*) arch=armv7 ;;
  i386|i486|i586|i686) arch=386 ;;
  *) fail 'Online selection is unavailable for this architecture; upload the matching official core' ;;
 esac
 asset="mihomo-linux-$arch-$LATEST.gz"
 url="$(jsonfilter -i "$WORK/release.json" -e "@.assets[@.name='$asset'].browser_download_url")"
 digest="$(jsonfilter -i "$WORK/release.json" -e "@.assets[@.name='$asset'].digest")"
 case "$url" in "https://github.com/MetaCubeX/mihomo/releases/download/$LATEST/$asset") ;; *) fail 'Official release has no asset for this architecture' ;; esac
 checksum="${digest#sha256:}"
 printf '%s\n' "$checksum" | grep -Eq '^[a-fA-F0-9]{64}$' || fail 'Official release has no valid SHA256; refusing to replace the core'
 progress running 35 'Downloading Mihomo for this architecture…'
 "$CURL" -fLsS --max-time 180 --max-filesize 67108864 --proto '=https' --proto-redir '=https' "$url" -o "$WORK/core.gz" 2>/dev/null || fail 'Core download failed; existing core unchanged'
 [ "$(sha256sum "$WORK/core.gz" | awk '{print $1}')" = "$(printf '%s' "$checksum" | tr A-F a-f)" ] || fail 'SHA256 mismatch; existing core unchanged'
 input="$WORK/core.gz"
else
 WORK="$(mktemp -d /tmp/mclash-update.XXXXXX)" || fail 'Unable to create update directory'
 [ -f "$UPLOAD" ] && [ ! -L "$UPLOAD" ] && [ -s "$UPLOAD" ] || fail 'Invalid uploaded file'
 [ "$(wc -c < "$UPLOAD")" -le 134217728 ] || fail 'Uploaded file exceeds 128 MiB'
 cp "$UPLOAD" "$WORK/upload" || fail 'Failed to read uploaded file'
 input="$WORK/upload"
fi
progress running 60 'Checking core and runtime configuration…'
magic="$(hexdump -v -n 4 -e '1/1 "%02x"' "$input")"
case "$magic" in
 1f8b*) gzip -dc "$input" 2>/dev/null | head -c 134217729 > "$WORK/mihomo" ;;
 7f454c46) cp "$input" "$WORK/mihomo" ;;
 *) fail 'Upload a Linux Mihomo ELF executable or an official .gz file' ;;
esac
[ -s "$WORK/mihomo" ] && [ "$(wc -c < "$WORK/mihomo")" -le 134217728 ] || fail 'Decompression failed or core exceeds 128 MiB'
[ "$(hexdump -v -n 4 -e '1/1 "%02x"' "$WORK/mihomo")" = 7f454c46 ] || fail 'Core file is not a Linux ELF executable'
chmod 0755 "$WORK/mihomo"
candidate_version="$(core_version "$WORK/mihomo")"
printf '%s\n' "$candidate_version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+' || fail 'Core cannot run; check the CPU architecture'
"$TIMEOUT" 45 "$WORK/mihomo" -t -d /etc/mclash -f "$CONFIG" > "$WORK/validation.log" 2>&1
validation_result=$?
if [ "$validation_result" != 0 ]; then
 reason='Configuration or rule resource validation failed'
 case "$validation_result" in 124|137) reason='Configuration validation timed out or ran out of memory' ;; esac
 grep -qiE 'unsupported|unknown field|not support' "$WORK/validation.log" && reason='New core does not support features in the current configuration'
 grep -qiE 'geosite|geoip|download|rule.?provider|no such file|no available' "$WORK/validation.log" && reason='Rule or geographic databases are unavailable; check resources and network connectivity'
 grep -qiE 'yaml|unmarshal|parse config' "$WORK/validation.log" && reason='Incompatible configuration YAML or field format'
 fail "$reason, Existing core unchanged; uploaded file retained for retry"
fi
[ "$mode" != worker-local ] || rm -f "$UPLOAD"
STAGED="$(mktemp /usr/bin/.mihomo-new.XXXXXX)" || fail 'Unable to create core staging file'
cp "$WORK/mihomo" "$STAGED" && chmod 0755 "$STAGED" || fail 'Failed to write core'
if [ -f "$CORE" ]; then
 BACKUP="$(mktemp /usr/bin/.mihomo-backup.XXXXXX)" || fail 'Unable to back up the existing core'
 cp -p "$CORE" "$BACKUP" || fail 'Failed to back up core'
fi
service_status="$("$UI" status)" || fail 'Unable to read service state; existing core unchanged'
WAS_RUNNING="$(printf '%s' "$service_status" | jsonfilter -e '@.running')"
service_active="$(printf '%s' "$service_status" | jsonfilter -e '@.active')"
case "$WAS_RUNNING" in true|false) ;; *) fail 'Invalid service state; existing core unchanged' ;; esac
[ "$service_active" != true ] || [ "$WAS_RUNNING" = true ] || fail 'Service is starting or exiting; retry the core update later'
[ "$WAS_RUNNING" = true ] && WAS_RUNNING=1 || WAS_RUNNING=0
if [ "$WAS_RUNNING" = 1 ]; then
 progress running 75 'Stopping service; it will resume after the update…'
 STOPPED=1
 "$INIT" stop >/dev/null 2>&1 || fail 'Failed to stop service'
else
 progress running 75 'Service is stopped; it will remain stopped after the update…'
fi
progress running 80 'Replacing core…'
mv -f "$STAGED" "$CORE" || fail 'Failed to replace core'
STAGED=''; SWAPPED=1
if [ "$WAS_RUNNING" = 1 ]; then
 "$INIT" start >/dev/null 2>&1 || fail 'Startup failed; restoring the previous core'
 progress running 90 'Starting and checking the new core…'
 wait_ready || fail 'New core is not ready; restoring the previous core'
fi
SUCCESS=1
if [ "$WAS_RUNNING" = 1 ]; then
 progress success 100 "Mihomo $candidate_version installed; service is running again"
else
 progress success 100 "Mihomo $candidate_version installed; service remains stopped"
fi
