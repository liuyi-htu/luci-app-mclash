#!/bin/sh
mclash_lock_stamp() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
mclash_lock_claim() { printf '%s %s %s\n' "$$" "$(mclash_lock_stamp $$)" "$1" > "$LOCK/owner.$$" && mv -f "$LOCK/owner.$$" "$LOCK/owner"; }
mclash_lock_acquire() {
 mkdir -p /var/lock
 if ! mkdir "$LOCK" 2>/dev/null; then
  read -r owner_pid owner_stamp owner_action 2>/dev/null < "$LOCK/owner" || owner_pid=''
  case "$owner_pid" in ''|*[!0-9]*)
   # Some OpenWrt images have no stat applet. Observe ownerless locks for
   # ten seconds before recovering; never steal a lock still being claimed.
   local now since
   now="$(date +%s)"
   (set -C; printf '%s\n' "$now" > "$LOCK/orphan-since") 2>/dev/null || true
   read -r since 2>/dev/null < "$LOCK/orphan-since" || return 1
   case "$since" in ''|*[!0-9]*) return 1 ;; esac
   [ "$((now - since))" -gt 10 ] || return 1
   read -r owner_pid owner_stamp owner_action 2>/dev/null < "$LOCK/owner" || owner_pid=''
   case "$owner_pid" in ''|*[!0-9]*) ;; *) return 1 ;; esac
   ;;
   *) [ "$(mclash_lock_stamp "$owner_pid")" != "$owner_stamp" ] || return 1 ;;
  esac
  rm -f "$LOCK/owner" "$LOCK/orphan-since"
  rmdir "$LOCK" 2>/dev/null && mkdir "$LOCK" 2>/dev/null || return 1
 fi
 mclash_lock_claim "$1"
}
mclash_lock_release() {
 read -r owner_pid owner_stamp owner_action 2>/dev/null < "$LOCK/owner" || return 1
 [ "$owner_pid" = "$$" ] || return 1
 rm -f "$LOCK/owner" "$LOCK/orphan-since"
 rmdir "$LOCK" 2>/dev/null
}
