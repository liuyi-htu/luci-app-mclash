#!/bin/sh
umask 077
CURL=/usr/bin/curl
[ "$#" -eq 1 ] || exit 1
kind="$1"
case "$kind" in
 telegram) url='https://telegram.org/' ;;
 openai) url='https://chatgpt.com/' ;;
 baidu) url='https://www.baidu.com/' ;;
 google) url='https://www.google.com/generate_204' ;;
 youtube) url='https://www.youtube.com/generate_204' ;;
 github) url='https://github.com/' ;;
 *) exit 1 ;;
esac
elapsed="$("$CURL" --silent --head --location --connect-timeout 4 --max-time 10 --proto '=https' --proto-redir '=https' --noproxy '*' --max-redirs 3 --output /dev/null --write-out '%{time_total}' "$url" 2>/dev/null)"
request_result=$?
latency_ok=0
if [ "$request_result" = 0 ]; then
 case "$elapsed" in ''|*[!0-9.]*|*.*.*) ;; *) latency_ok=1 ;; esac
fi
. /usr/share/libubox/jshn.sh
json_init
json_add_boolean ip_supported 0
if [ "$latency_ok" = 1 ]; then json_add_boolean ok 1; else json_add_boolean ok 0; fi
if [ "$latency_ok" = 1 ]; then json_add_int latency "$(awk -v seconds="$elapsed" 'BEGIN {printf "%.0f",seconds*1000}')"; else json_add_string latency_error '连接失败或超时'; fi
json_dump
