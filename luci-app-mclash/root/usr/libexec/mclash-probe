#!/bin/sh
umask 077
CONFIG=/etc/mclash/config.yaml
CURL=/usr/bin/curl
. /usr/share/libubox/jshn.sh
[ "$#" -eq 1 ] || exit 1
case "$1" in
 telegram) url=https://telegram.org ;;
 openai) url=https://chatgpt.com ;;
 aliyun) url=https://www.aliyun.com ;;
 google) url=https://www.google.com/generate_204 ;;
 github) url=https://github.com ;;
 youtube) url=https://www.youtube.com/generate_204 ;;
 *) exit 1 ;;
esac
set -- "$1" --noproxy '*'
kind="$1"; shift
probe_file="$(mktemp /tmp/mclash-probe.XXXXXX)" || exit 1
trap 'rm -f "$probe_file"' EXIT
trap 'exit 1' HUP INT TERM
request() {
 "$CURL" --silent --location --connect-timeout 4 --max-time 10 --proto '=https' --proto-redir '=https' "$@" --output "$request_output" --write-out '%{time_total}' "$request_url" 2>/dev/null
}
latency_ok=0
request_url="$url"
request_output=/dev/null
elapsed="$(request "$@" --head)" && latency_ok=1
case "$kind" in aliyun) exit_kind=domestic ;; *) exit_kind=foreign ;; esac
case "$exit_kind" in domestic) request_url=https://myip.ipip.net ;; foreign) request_url=https://ipwho.is ;; esac
request_output="$probe_file"
request "$@" --fail --max-filesize 8192 >/dev/null
exit_result=$?
ip=''; region=''
if [ "$exit_result" = 0 ]; then
 case "$exit_kind" in
  domestic)
   ip="$(sed -n 's/^.*当前 IP：\([^ ]*\).*$/\1/p' "$probe_file" | head -1)"
   region="$(sed -n 's/^.*来自于：\(.*\)$/\1/p' "$probe_file" | head -1)"
   ;;
  foreign)
   ip="$(jsonfilter -i "$probe_file" -e '@.ip' 2>/dev/null)"
   country="$(jsonfilter -i "$probe_file" -e '@.country' 2>/dev/null)"
   city="$(jsonfilter -i "$probe_file" -e '@.city' 2>/dev/null)"
   region="$country $city"
   ;;
 esac
fi
ip_ok=1
case "$ip" in ''|*[!0-9A-Fa-f:.]*) ip_ok=0 ;; esac
case "$elapsed" in ''|*[!0-9.]*|*.*.*) latency_ok=0 ;; esac
json_init
if [ "$ip_ok" = 1 ] && [ "$latency_ok" = 1 ]; then json_add_boolean ok 1; else json_add_boolean ok 0; fi
if [ "$ip_ok" = 1 ]; then json_add_string ip "$ip"; json_add_string region "$region"; else json_add_string ip_error '出口查询失败'; fi
if [ "$latency_ok" = 1 ]; then
 json_add_int latency "$(awk -v seconds="$elapsed" 'BEGIN {printf "%.0f",seconds*1000}')"
else
 json_add_string latency_error '连接失败或超时'
fi
json_dump
