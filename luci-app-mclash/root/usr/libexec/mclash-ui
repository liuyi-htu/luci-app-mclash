#!/bin/sh
# Fixed commands and paths; no browser-provided shell commands or file paths.
umask 077
CORE=/usr/bin/mihomo
INIT=/etc/init.d/mclash
CONFIG=/etc/mclash/config.yaml
UPLOAD=/etc/mclash/config.upload.yaml
LOCK=/var/lock/mclash-ui.lock
CANDIDATE=''
REQUEST=/etc/mclash/api.request.json
URLFILE=/etc/mclash/subscription.url
CURL=/usr/bin/curl
TIMEOUT=/usr/libexec/mclash-timeout
FETCH=''; FETCH_PID=''; FETCH_HEADERS=''
. /usr/libexec/mclash-lock

fail() { printf '%s\n' "$1" >&2; exit 1; }
service_active() {
	local info
	info="$(ubus call service list '{"name":"mclash"}' 2>/dev/null)" || return 1
	[ "$(printf '%s' "$info" | jsonfilter -e '@.mclash.instances.main.running')" = true ] || return 1
}
running() {
	local pid
	service_active || return 1
	pid="$(cat /var/run/mclash/core.pid 2>/dev/null)"
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ "$(readlink "/proc/$pid/exe")" = "$CORE" ] && kill -0 "$pid" 2>/dev/null || return 1
	local mode
	mode="$(sed -n 's/^# Mclash OpenWrt capture: //p' "$CONFIG" | jsonfilter -e '@.mode' 2>/dev/null)"
	case "$mode" in tun|tproxy) [ "$(cat /var/run/mclash/network.ready 2>/dev/null)" = "$mode" ] ;; *) return 0 ;; esac
}
core_version() {
 [ -x "$CORE" ] || return 1
 local value
 value="$("$TIMEOUT" 5 "$CORE" -v 2>/dev/null)" || return 1
 case "$value" in Mihomo\ *) printf '%s\n' "$value" | head -n 1 ;; *) return 1 ;; esac
}
validate() {
 core_version >/dev/null || fail 'Mihomo core is missing or cannot run; install /usr/bin/mihomo for the router architecture'
	[ -x "$CORE" ] || fail 'Install the /usr/bin/mihomo core first'
	[ -f "$1" ] && [ ! -L "$1" ] || fail 'Configuration file is missing or is a symbolic link'
	[ -s "$1" ] || fail 'The configuration must not be empty'
	[ "$(wc -c < "$1")" -le 1048576 ] || fail 'The configuration must not exceed 1 MiB'
	# Core diagnostics may contain secrets: expose only a generic result.
	"$TIMEOUT" 30 "$CORE" -t -d /etc/mclash -f "$1" >/dev/null 2>&1 || fail 'Mihomo configuration validation failed or timed out; check YAML, nodes and rule resources'
}
lock() {
	mkdir -p /var/lock
	mclash_lock_acquire "$ACTION" || fail 'Another operation is in progress; retry later'
	trap '[ -z "$FETCH_PID" ] || kill "$FETCH_PID" 2>/dev/null; rm -f "$UPLOAD" "$REQUEST" "$URLFILE"; [ -z "$CANDIDATE" ] || rm -f "$CANDIDATE"; [ -z "$FETCH" ] || rm -f "$FETCH"; [ -z "$FETCH_HEADERS" ] || rm -f "$FETCH_HEADERS"; mclash_lock_release' EXIT
	trap 'exit 1' HUP INT TERM
}
[ "$#" -eq 1 ] || fail 'Invalid arguments'
ACTION="$1"
case "$1" in
 probe-telegram|probe-openai|probe-baidu|probe-google|probe-youtube|probe-github) exec /usr/libexec/mclash-probe "${1#probe-}" ;;
 check-update) exec /usr/libexec/mclash-update check ;;
 update-online) exec /usr/libexec/mclash-update online ;;
 update-local) exec /usr/libexec/mclash-update local ;;
 update-status) exec /usr/libexec/mclash-update status ;;
esac
case "$1" in
 cancel-fetch)
  read -r owner_pid owner_stamp owner_action 2>/dev/null < "$LOCK/owner" || { printf 'No subscription fetch is in progress\n'; exit 0; }
  [ "$owner_action" = fetch-subscription ] || fail 'The current operation is not a subscription fetch'
  case "$owner_pid" in ''|*[!0-9]*) fail 'Invalid subscription process' ;; esac
  if [ "$(mclash_lock_stamp "$owner_pid")" = "$owner_stamp" ]; then kill -TERM "$owner_pid" 2>/dev/null || true; fi
  printf 'Subscription fetch cancelled\n'
  ;;
	status)
		. /usr/share/libubox/jshn.sh
		json_init
		installed=0; active=0; started=0; enabled=0; version=''
		if version="$(core_version)"; then installed=1; fi
		running && active=1
		service_active && started=1
		"$INIT" enabled >/dev/null 2>&1 && enabled=1
		json_add_boolean installed "$installed"
		json_add_boolean running "$active"
		json_add_boolean active "$started"
		json_add_boolean enabled "$enabled"
		json_add_string version "$version"
		capture="$(cat /var/run/mclash/network.ready 2>/dev/null)"
		case "$capture" in tun|tproxy) ;; *) capture=none ;; esac
		json_add_string capture "$capture"
		json_dump
		;;
	devices)
		. /usr/share/libubox/jshn.sh
		json_init; json_add_array devices
		for device in /sys/class/net/*; do
			name="${device##*/}"
			case "$name" in lo|Mclash) continue ;; esac
			[ -d "$device" ] && json_add_string '' "$name"
		done
		json_close_array; json_dump
		;;
	read-config) [ -f "$CONFIG" ] || fail 'Configuration file does not exist'; /usr/libexec/mclash-config-language "$CONFIG" ;;
	update-logs) [ ! -f /var/log/mclash-update.log ] || tail -c 524288 /var/log/mclash-update.log | tail -n 100 ;;
	logs) [ ! -f /var/log/mihomo.log ] || tail -c 524288 /var/log/mihomo.log | tail -n 100 ;;
	service-logs) [ ! -f /var/log/mclash.log ] || tail -c 524288 /var/log/mclash.log | tail -n 300 ;;
	clear-service-logs) /usr/libexec/mclash-log clear-service || fail 'Failed to clear logs'; printf '%s\n' 'Logs cleared' ;;
	clear-logs) /usr/libexec/mclash-log clear-core || fail 'Failed to clear logs'; printf '%s\n' 'Logs cleared' ;;
	clear-update-logs) /usr/libexec/mclash-log clear-update || fail 'Failed to clear logs'; printf '%s\n' 'Logs cleared' ;;
	validate) lock; validate "$CONFIG"; printf '%s\n' 'Configuration validation passed' ;;
	save)
		lock
		if service_active; then
			running && fail 'Stop the proxy before changing the configuration'
			fail 'Service is starting or exiting; stop it before changing the configuration'
		fi
		[ -f "$UPLOAD" ] && [ ! -L "$UPLOAD" ] || fail 'Configuration upload is missing'
		[ "$(wc -c < "$UPLOAD")" -le 1048576 ] || fail 'The configuration must not exceed 1 MiB'
		CANDIDATE="$(mktemp /etc/mclash/.config.XXXXXX)" || fail 'Unable to create temporary configuration'
		/usr/libexec/mclash-config-language "$UPLOAD" > "$CANDIDATE" || fail 'Failed to read configuration'
		validate "$CANDIDATE"
		chmod 0600 "$CANDIDATE" || fail 'Failed to set configuration permissions'
		mv -f "$CANDIDATE" "$CONFIG" || fail 'Failed to save configuration'
		printf '%s\n' 'Configuration saved; changes take effect when the service starts'
		;;
	fetch-subscription)
		lock
		[ -f "$URLFILE" ] && [ ! -L "$URLFILE" ] || fail 'Subscription URL is missing'
		[ "$(wc -c < "$URLFILE")" -le 4096 ] || fail 'Subscription URL is too long'
		url="$(cat "$URLFILE")"
		case "$url" in http://*|https://*) ;; *) fail 'Subscription URL must use HTTP or HTTPS' ;; esac
		[ "$(printf '%s' "$url" | tr -d '\r\n')" = "$url" ] || fail 'Only one subscription can be downloaded at a time'
		FETCH="$(mktemp /tmp/mclash-subscription.XXXXXX)" || fail 'Unable to create download file'
		FETCH_HEADERS="$(mktemp /tmp/mclash-subscription-headers.XXXXXX)" || fail 'Unable to create subscription header file'
		"$TIMEOUT" 25 "$CURL" --fail --silent --location --connect-timeout 5 --max-time 20 --max-filesize 1048576 \
			--proto '=http,https' --proto-redir '=http,https' --user-agent clash.meta \
			--dump-header "$FETCH_HEADERS" --output "$FETCH" "$url" &
  FETCH_PID=$!
  wait "$FETCH_PID"; fetch_result=$?; FETCH_PID=''
  [ "$fetch_result" = 0 ] || fail 'Subscription download failed, timed out or exceeded 1 MiB; try another URL'
		[ -s "$FETCH" ] && [ "$(wc -c < "$FETCH")" -le 1048576 ] || fail 'Subscription content is empty or too large'
		user_info="$(awk 'BEGIN {IGNORECASE=1} /^HTTP\// {value=""} tolower($0) ~ /^subscription-userinfo:/ {sub(/^[^:]*:[ \t]*/, ""); sub(/\r$/, ""); value=$0} END {print value}' "$FETCH_HEADERS")"
		[ -z "$user_info" ] || printf '# Mclash subscription-usage: %s\n' "$user_info"
		cat "$FETCH"
		;;
	api)
		lock
		[ -f "$REQUEST" ] && [ ! -L "$REQUEST" ] || fail 'Proxy control request is missing'
		[ "$(wc -c < "$REQUEST")" -le 16384 ] || fail 'Request is too large'
		request="$(cat "$REQUEST")"
		port="$(printf '%s' "$request" | jsonfilter -e '@.port')"
		case "$port" in ''|*[!0-9]*) fail 'Invalid controller port' ;; esac
		[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || fail 'Invalid controller port'
		secret="$(printf '%s' "$request" | jsonfilter -e '@.secret')"
		[ "$(printf '%s' "$secret" | tr -d '\r\n')" = "$secret" ] || fail 'Invalid controller secret'
		op="$(printf '%s' "$request" | jsonfilter -e '@.op')"
		method=GET; endpoint=proxies; body=''
		case "$op" in
			proxies) ;;
			configs|connections) endpoint="$op" ;;
			mode)
				mode="$(printf '%s' "$request" | jsonfilter -e '@.mode')"
				case "$mode" in rule|global|direct) ;; *) fail 'Invalid proxy mode' ;; esac
				method=PATCH; endpoint=configs; body="{\"mode\":\"$mode\"}"
				;;
			select)
				group="$(printf '%s' "$request" | jsonfilter -e '@.group')"
				[ -n "$group" ] || fail 'Proxy group is missing'
				case "$group" in *[!A-Za-z0-9_.~%\!\*\'\(\)-]*) fail 'Invalid proxy group encoding' ;; esac
				name="$(printf '%s' "$request" | jsonfilter -e '@.name')"
				[ -n "$name" ] || fail 'Node name is missing'
				. /usr/share/libubox/jshn.sh
				json_init; json_add_string name "$name"; body="$(json_dump)"
				method=PUT; endpoint="proxies/$group"
				;;
			*) fail 'Invalid proxy operation' ;;
		esac
		controller_host="$(awk '$1 == "external-controller:" {gsub(/["\047]/, "", $2); sub(/:[0-9]+$/, "", $2); print $2; exit}' "$CONFIG")"
		case "$controller_host" in 0.0.0.0|localhost|'[::]') controller_host=127.0.0.1 ;; esac
		address="$(printf '%s' "$controller_host" | tr -d '[]')"
		case "$address" in ''|*[!0-9A-Fa-f:.]*) fail 'Invalid local controller address' ;; esac
		/sbin/ip -o address show | awk -v address="$address" '$3 == "inet" || $3 == "inet6" {split($4,a,"/"); if(a[1] == address) found=1} END {exit !found}' || fail 'Controller must listen on a local router address'
		FETCH="$(mktemp /tmp/mclash-api.XXXXXX)" || fail 'Unable to create response file'
		"$CURL" --fail --silent --max-time 8 --max-filesize 1048576 --noproxy '*' \
			--request "$method" --header "Authorization: Bearer $secret" \
			--header 'Content-Type: application/json' --data "$body" \
			--output "$FETCH" "http://$controller_host:$port/$endpoint" || fail 'Failed to connect to Mihomo controller; check service status, listen address and secret'
		cat "$FETCH"
		;;
	start|restart)
		lock
		validate "$CONFIG"
		"$INIT" "$1" || fail 'Service operation failed'
		ready=0
		for n in $(seq 1 35); do running && ready=1 && break; sleep 1; done
		[ "$ready" = 1 ] || fail 'Core or capture rules are not ready; check the system log'
		printf '%s\n' 'Service already running'
		;;
	stop|enable|disable)
		lock
		"$INIT" "$1" || fail 'Service operation failed'
		if [ "$1" = stop ]; then
			/usr/libexec/mclash-network down || fail 'Capture cleanup failed; check the log'
			stopped=0
			for n in $(seq 1 20); do
				if ! service_active; then stopped=1; break; fi
				sleep 1
			done
			[ "$stopped" = 1 ] || fail 'Service stop timed out; check the log'
		fi
		printf '%s\n' 'Operation completed'
		;;
	*) fail 'Unsupported operation' ;;
esac
